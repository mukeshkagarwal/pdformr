# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.
# Find them in Supabase → Project Settings → API Keys.
#
# Use the PUBLISHABLE key (sb_publishable_…). It is designed to be public; row level
# security protects the data. NEVER put the secret key (sb_secret_… / service_role) here —
# the app refuses to start with one.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
